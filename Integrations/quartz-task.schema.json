{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.quartz/task-request.schema.json",
  "title": "Demande de création de tâche Quartz",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 240 },
    "date": {
      "type": "string",
      "description": "aujourd’hui, demain ou AAAA-MM-JJ"
    },
    "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "recurrence": {
      "type": "string",
      "enum": ["none", "daily", "weekdays", "weekly", "monthly"]
    },
    "reminder": {
      "type": "string",
      "enum": ["none", "at-time", "5m", "15m", "30m", "1h"]
    },
    "notes": { "type": "string", "maxLength": 10000 },
    "source": { "type": "string" },
    "id": { "type": "string", "format": "uuid" },
    "subtasks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "description": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}
